# ============================================================
# chat-storm backend configuration
# 复制此文件为 .env 并填入你的配置
# ============================================================

# 选择 LLM Provider: ollama | dashscope | minimax | zhipu | kimi
LLM_PROVIDER=ollama

# ── Ollama (本地，免费) ───────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# 本地路由模型（仅 ollama provider 下生效，可选）
OLLAMA_MODEL_ROUTER=dolphin-mistral

# 视觉模型（理解图片，可选）
OLLAMA_MODEL_VISION=qwen3-vl:4b

# ── Dashscope / 阿里云百炼 ───────────────────────────────────
# LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# ── MiniMax ──────────────────────────────────────────────────
# LLM_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M1

# ── Zhipu GLM ────────────────────────────────────────────────
# LLM_PROVIDER=zhipu
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4

# ── Kimi / Moonshot ──────────────────────────────────────────
# LLM_PROVIDER=kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ── Per-Agent 模型覆盖（可选，留空则全部用上面的默认模型）────
# LLM_MODEL_ALPHA=qwen-plus
# LLM_MODEL_BETA=moonshot-v1-8k
# LLM_MODEL_GAMMA=glm-4
# LLM_MODEL_DELTA=qwen-plus

# ── 语音识别 ASR（可选，前端优先用浏览器原生 Web Speech API）─
DASHSCOPE_ASR_KEY=
DASHSCOPE_ASR_MODEL=fun-asr-realtime

# ── 向量记忆 Embedding（可选，需要 pip install chromadb）──────
DASHSCOPE_EMBED_KEY=
DASHSCOPE_EMBED_MODEL=text-embedding-v4
