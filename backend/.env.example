# ============================================================
# OpenClaw Chat Room — Backend Configuration
# ============================================================
# 选择 LLM Provider: ollama | dashscope | minimax | zhipu | kimi
LLM_PROVIDER=ollama

# ── Ollama (local, free) ─────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_MODEL_ALPHA=qwen2.5             # Alpha 总架构师
OLLAMA_MODEL_BETA=qwen2.5             # Beta  代码工匠
OLLAMA_MODEL_GAMMA=qwen2.5             # Gamma 质量守门员
OLLAMA_MODEL_DELTA=qwen2.5            # Delta  运维大脑
OLLAMA_MODEL_VISION=qwen3-vl:4b       # 视觉模型（理解图片）

# ── Local Router (Ollama 小模型) ──────────────────────────
OLLAMA_MODEL_ROUTER=dolphin-mistral  # 本地路由模型（判断消息类型和目标 Agent）

# ── Dashscope (Aliyun qwen) ─────────────────────────────────
# 设置 LLM_PROVIDER=dashscope 并填入 key
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.5-plus

# ── MiniMax ─────────────────────────────────────────────────
# 设置 LLM_PROVIDER=minimax 并填入 key
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic/v1
MINIMAX_MODEL=MiniMax-M2.7

# ── Zhipu GLM ──────────────────────────────────────────────
# 设置 LLM_PROVIDER=zhipu 并填入 key
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4

# ── Kimi / Moonshot ─────────────────────────────────────────
# 设置 LLM_PROVIDER=kimi 并填入 key
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ── Dashscope Bailian ASR (语音识别) ────────────────────
# 百炼模型：fun-asr-realtime | qwen-audio-asr | qwen-audio-asr-latest
DASHSCOPE_ASR_KEY=
DASHSCOPE_ASR_MODEL=fun-asr-realtime

# ── Dashscope Bailian Embedding (向量记忆) ───────────────
# 百炼模型：text-embedding-v4
DASHSCOPE_EMBED_KEY=
DASHSCOPE_EMBED_MODEL=text-embedding-v4

# ── Per-Agent 模型覆盖
# LLM_MODEL_BETA=moonshot-v1-8k
# LLM_MODEL_GAMMA=MiniMax-M2.7
# LLM_MODEL_DELTA=qwen3.5-plus
